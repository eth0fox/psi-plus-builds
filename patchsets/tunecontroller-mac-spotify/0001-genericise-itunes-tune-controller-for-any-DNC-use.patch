From 37424ddd640d30cbffa3d76ee9df31518e294049 Mon Sep 17 00:00:00 2001
From: fox <fox@boxfox.es>
Date: Sun, 9 Aug 2026 10:28:20 +0100
Subject: [PATCH 1/2] genericise itunes tune controller for any DNC use

---
 src/tools/CMakeLists.txt                      |  9 +++--
 .../tunecontroller/itunestunecontroller.h     | 21 ----------
 ...ontroller.cpp => macdnctunecontroller.cpp} | 38 +++++++++----------
 .../tunecontroller/macdnctunecontroller.h     | 22 +++++++++++
 .../plugins/itunes/itunesplugin.cpp           |  4 +-
 5 files changed, 49 insertions(+), 45 deletions(-)
 delete mode 100644 src/tools/tunecontroller/itunestunecontroller.h
 rename src/tools/tunecontroller/{itunestunecontroller.cpp => macdnctunecontroller.cpp} (71%)
 create mode 100644 src/tools/tunecontroller/macdnctunecontroller.h

diff --git a/src/tools/CMakeLists.txt b/src/tools/CMakeLists.txt
index 8455b6c6..02ca6594 100644
--- a/src/tools/CMakeLists.txt
+++ b/src/tools/CMakeLists.txt
@@ -94,15 +94,18 @@ include_directories(
 
 if(APPLE)
     list(APPEND EXTRA_LDFLAGS "-framework CoreFoundation")
-    include_directories(tunecontroller/plugins/itunes)
+    include_directories(
+        tunecontroller/plugins/itunes
+    )
     add_definitions(-DTC_ITUNES)
     list(APPEND SOURCES
-        tunecontroller/itunestunecontroller.cpp
+        tunecontroller/macdnctunecontroller.cpp
         tunecontroller/plugins/itunes/itunesplugin.cpp
+        tunecontroller/plugins/mac_spotify/mac_spotifyplugin.cpp
     )
 
     list(APPEND HEADERS
-        tunecontroller/itunestunecontroller.h
+        tunecontroller/macdnctunecontroller.h
     )
 elseif(WIN32)
     list(APPEND EXTRA_LDFLAGS user32)
diff --git a/src/tools/tunecontroller/itunestunecontroller.h b/src/tools/tunecontroller/itunestunecontroller.h
deleted file mode 100644
index c65e653c..00000000
--- a/src/tools/tunecontroller/itunestunecontroller.h
+++ /dev/null
@@ -1,21 +0,0 @@
-#ifndef ITUNESTUNECONTROLLER_H
-#define ITUNESTUNECONTROLLER_H
-
-#include "tunecontrollerinterface.h"
-
-#include <CoreFoundation/CoreFoundation.h>
-#include <QString>
-
-class ITunesController : public TuneController {
-public:
-    ITunesController();
-    ~ITunesController();
-
-    virtual Tune currentTune() const;
-
-private:
-    static void iTunesCallback(CFNotificationCenterRef, void *, CFStringRef, const void *, CFDictionaryRef info);
-    Tune        currentTune_;
-};
-
-#endif // ITUNESTUNECONTROLLER_H
diff --git a/src/tools/tunecontroller/itunestunecontroller.cpp b/src/tools/tunecontroller/macdnctunecontroller.cpp
similarity index 71%
rename from src/tools/tunecontroller/itunestunecontroller.cpp
rename to src/tools/tunecontroller/macdnctunecontroller.cpp
index 95f959da..2d06b3a8 100644
--- a/src/tools/tunecontroller/itunestunecontroller.cpp
+++ b/src/tools/tunecontroller/macdnctunecontroller.cpp
@@ -1,6 +1,7 @@
 /*
- * itunestunecontroller.cpp
+ * macdnctunecontroller.cpp
  * Copyright (C) 2006  Remko Troncon
+ * Copyright (C) 2026  Taylor Fox
  *
  * This program is free software; you can redistribute it and/or
  * modify it under the terms of the GNU General Public License
@@ -17,7 +18,7 @@
  *
  */
 
-#include "itunestunecontroller.h"
+#include "macdnctunecontroller.h"
 
 #include <CoreFoundation/CoreFoundation.h>
 #include <QDebug>
@@ -26,7 +27,7 @@
 #include <QtGlobal>
 
 /**
- * \class ITunesController
+ * \class MacDNCController
  * \brief A controller for the Mac OS X version of iTunes.
  */
 
@@ -40,45 +41,44 @@ static QString CFStringToQString(CFStringRef s)
         if (CFStringGetCString(s, buffer, length, kCFStringEncodingUTF8)) {
             result = QString::fromUtf8(buffer);
         } else {
-            qWarning("itunesplayer.cpp: CFString conversion failed.");
+            qWarning("macdnctunecontroller.cpp: CFString conversion failed.");
         }
         delete[] buffer;
     }
     return result;
 }
 
-ITunesController::ITunesController()
+MacDNCController::MacDNCController(CFStringRef notificationName) : notificationName_(notificationName)
 {
-    // TODO: Poll iTunes for current playing tune
     CFNotificationCenterRef center = CFNotificationCenterGetDistributedCenter();
-    CFNotificationCenterAddObserver(center, this, ITunesController::iTunesCallback,
-                                    CFSTR("com.apple.iTunes.playerInfo"), NULL,
+    CFNotificationCenterAddObserver(center, this, MacDNCController::NotificationCallback,
+                                    notificationName_, NULL,
                                     CFNotificationSuspensionBehaviorDeliverImmediately);
 }
 
-ITunesController::~ITunesController()
+MacDNCController::~MacDNCController()
 {
     CFNotificationCenterRef center = CFNotificationCenterGetDistributedCenter();
-    CFNotificationCenterRemoveObserver(center, this, CFSTR("com.apple.iTunes.playerInfo"), NULL);
+    CFNotificationCenterRemoveObserver(center, this, notificationName_, NULL);
 }
 
-Tune ITunesController::currentTune() const { return currentTune_; }
+Tune MacDNCController::currentTune() const { return currentTune_; }
 
-void ITunesController::iTunesCallback(CFNotificationCenterRef, void *observer, CFStringRef, const void *,
+void MacDNCController::NotificationCallback(CFNotificationCenterRef, void *observer, CFStringRef, const void *,
                                       CFDictionaryRef info)
 {
     Tune              tune;
-    ITunesController *controller = (ITunesController *)observer;
+    MacDNCController *controller = (MacDNCController *)observer;
 
     CFStringRef cf_state = (CFStringRef)CFDictionaryGetValue(info, CFSTR("Player State"));
     if (CFStringCompare(cf_state, CFSTR("Paused"), 0) == kCFCompareEqualTo) {
-        // qDebug() << "itunesplayer.cpp: Paused";
+        // qDebug() << "macdnctunecontroller.cpp: Paused";
         emit controller->stopped();
     } else if (CFStringCompare(cf_state, CFSTR("Stopped"), 0) == kCFCompareEqualTo) {
-        // qDebug() << "itunesplayer.cpp: Stopped";
+        // qDebug() << "macdnctunecontroller.cpp: Stopped";
         emit controller->stopped();
     } else if (CFStringCompare(cf_state, CFSTR("Playing"), 0) == kCFCompareEqualTo) {
-        // qDebug() << "itunesplayer.cpp: Playing";
+        // qDebug() << "macdnctunecontroller.cpp: Playing";
         tune.setArtist(CFStringToQString((CFStringRef)CFDictionaryGetValue(info, CFSTR("Artist"))));
         tune.setName(CFStringToQString((CFStringRef)CFDictionaryGetValue(info, CFSTR("Name"))));
         tune.setAlbum(CFStringToQString((CFStringRef)CFDictionaryGetValue(info, CFSTR("Album"))));
@@ -87,7 +87,7 @@ void ITunesController::iTunesCallback(CFNotificationCenterRef, void *observer, C
         if (cf_track) {
             int tracknr;
             if (!CFNumberGetValue(cf_track, kCFNumberIntType, &tracknr)) {
-                qWarning("itunesplayer.cpp: Number value conversion failed.");
+                qWarning("macdnctunecontroller.cpp: Number value conversion failed.");
             }
             tune.setTrack(QString::number(tracknr));
         }
@@ -95,12 +95,12 @@ void ITunesController::iTunesCallback(CFNotificationCenterRef, void *observer, C
         CFNumberRef cf_time = (CFNumberRef)CFDictionaryGetValue(info, CFSTR("Total Time"));
         int         time    = 0;
         if (cf_time && !CFNumberGetValue(cf_time, kCFNumberIntType, &time)) {
-            qWarning("itunesplayer.cpp: Number value conversion failed.");
+            qWarning("macdnctunecontroller.cpp: Number value conversion failed.");
         }
         tune.setTime((unsigned int)(time / 1000));
         controller->currentTune_ = tune;
         emit controller->playing(tune);
     } else {
-        qWarning("itunesplayer.cpp: Unknown state.");
+        qWarning("macdnctunecontroller.cpp: Unknown state.");
     }
 }
diff --git a/src/tools/tunecontroller/macdnctunecontroller.h b/src/tools/tunecontroller/macdnctunecontroller.h
new file mode 100644
index 00000000..349e8119
--- /dev/null
+++ b/src/tools/tunecontroller/macdnctunecontroller.h
@@ -0,0 +1,22 @@
+#ifndef MACDNCTUNECONTROLLER_H
+#define MACDNCTUNECONTROLLER_H
+
+#include "tunecontrollerinterface.h"
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <QString>
+
+class MacDNCController : public TuneController {
+public:
+    MacDNCController(CFStringRef notificationName);
+    ~MacDNCController();
+
+    virtual Tune currentTune() const;
+
+private:
+    static void NotificationCallback(CFNotificationCenterRef, void *, CFStringRef, const void *, CFDictionaryRef info);
+    CFStringRef notificationName_;
+    Tune        currentTune_;
+};
+
+#endif // MACDNCTUNECONTROLLER_H
diff --git a/src/tools/tunecontroller/plugins/itunes/itunesplugin.cpp b/src/tools/tunecontroller/plugins/itunes/itunesplugin.cpp
