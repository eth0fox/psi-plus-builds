From 61f3039d43385e3c2edca9e8eb2fdc2c954699be Mon Sep 17 00:00:00 2001
From: fox <fox@boxfox.es>
Date: Sun, 9 Aug 2026 10:29:07 +0100
Subject: [PATCH 2/2] listen to spotify DNC events

---
 src/tools/CMakeLists.txt                      |  1 +
 .../tunecontroller/macdnctunecontroller.cpp   | 10 ++++
 .../plugins/mac_spotify/mac_spotifyplugin.cpp | 46 +++++++++++++++++++
 src/tools/tunecontroller/tunecontroller.pri   |  4 ++
 .../tunecontroller/tunecontrollermanager.cpp  |  1 +
 5 files changed, 62 insertions(+)
 create mode 100644 src/tools/tunecontroller/plugins/mac_spotify/mac_spotifyplugin.cpp

diff --git a/src/tools/CMakeLists.txt b/src/tools/CMakeLists.txt
index 02ca6594..e71cdf67 100644
--- a/src/tools/CMakeLists.txt
+++ b/src/tools/CMakeLists.txt
@@ -96,6 +96,7 @@ if(APPLE)
     list(APPEND EXTRA_LDFLAGS "-framework CoreFoundation")
     include_directories(
         tunecontroller/plugins/itunes
+        tunecontroller/plugins/mac_spotify
     )
     add_definitions(-DTC_ITUNES)
     list(APPEND SOURCES
diff --git a/src/tools/tunecontroller/macdnctunecontroller.cpp b/src/tools/tunecontroller/macdnctunecontroller.cpp
index 2d06b3a8..217a129c 100644
--- a/src/tools/tunecontroller/macdnctunecontroller.cpp
+++ b/src/tools/tunecontroller/macdnctunecontroller.cpp
@@ -93,11 +93,21 @@ void MacDNCController::NotificationCallback(CFNotificationCenterRef, void *obser
         }
 
         CFNumberRef cf_time = (CFNumberRef)CFDictionaryGetValue(info, CFSTR("Total Time"));
+        if (!cf_time) cf_time = (CFNumberRef)CFDictionaryGetValue(info, CFSTR("Duration")); // Spotify uses 'Duration' instead of 'Total Time'
         int         time    = 0;
         if (cf_time && !CFNumberGetValue(cf_time, kCFNumberIntType, &time)) {
             qWarning("macdnctunecontroller.cpp: Number value conversion failed.");
         }
         tune.setTime((unsigned int)(time / 1000));
+
+        CFStringRef cf_trackId = (CFStringRef)CFDictionaryGetValue(info, CFSTR("Track ID"));
+        if (cf_trackId && CFStringHasPrefix(cf_trackId, CFSTR("spotify:"))) {
+            QString url = CFStringToQString(cf_trackId)
+                .replace(QChar(':'), QChar('/'));
+                .replace("spotify/", "https://open.spotify.com/")
+            tune.setURL(url);
+        }
+
         controller->currentTune_ = tune;
         emit controller->playing(tune);
     } else {
diff --git a/src/tools/tunecontroller/plugins/mac_spotify/mac_spotifyplugin.cpp b/src/tools/tunecontroller/plugins/mac_spotify/mac_spotifyplugin.cpp
new file mode 100644
index 00000000..1d3933cb
--- /dev/null
+++ b/src/tools/tunecontroller/plugins/mac_spotify/mac_spotifyplugin.cpp
@@ -0,0 +1,46 @@
